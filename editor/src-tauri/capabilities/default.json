{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:scope-app-recursive",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {"path": "$USER_SELECTED"     }, {"path": "$USER_SELECTED/**/*"}, {"path": "$APPDATA"           },
        {"path": "$APPDATA/**/*"      }, {"path": "**"                 }
      ]
    },
    "oauth:allow-start",
    "oauth:allow-cancel",
    "opener:default",
    "opener:allow-open-url",
    "keyring:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{"path": "$APPDATA/**/*"}]
    },
    "dialog:default",
    "fs:scope-resource-recursive"
  ]
}
